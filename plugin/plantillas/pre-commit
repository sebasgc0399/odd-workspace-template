#!/bin/sh
raiz=$(git rev-parse --show-toplevel) || exit 1
if ! python -c "" 2>/dev/null; then
    echo "pre-commit: python no corre desde el PATH; /odd-ws:doctor lo revisa (item python)" >&2
    exit 1
fi
if [ -f "$raiz/.claude/plugin/scripts/reglas.py" ]; then
    plugin="$raiz/.claude/plugin"
else
    plugin=$(python -c 'import json, sys
try:
    with open(sys.argv[1], encoding="utf-8-sig") as f:
        valor = json.load(f).get("plugin_root")
    print(valor if isinstance(valor, str) else "")
except Exception:
    pass' "$raiz/workspace.local.json")
fi
if [ -z "$plugin" ] || [ ! -f "$plugin/scripts/reglas.py" ]; then
    echo "pre-commit: no se encuentra el plugin odd-ws (plugin_root en workspace.local.json: ${plugin:-sin anotar})" >&2
    echo "pre-commit: se arregla con /odd-ws:doctor --arreglar plugin-root, o con la copia de emergencia en .claude/plugin" >&2
    exit 1
fi
exec python "$plugin/scripts/reglas.py" --test --raiz "$raiz"
