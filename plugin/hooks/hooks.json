{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verificar_capa.py", "--plazo", "8"], "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verificar_capa.py", "--plazo", "8"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/writer_guard.py", "--plazo", "8"], "timeout": 10, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/guard_comandos.py", "--plazo", "8"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verificar_capa.py", "--plazo", "25"], "timeout": 30, "onFailure": "block" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/verificar_capa.py", "--plazo", "8"], "timeout": 10, "onFailure": "block" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^writer-[a-z0-9][a-z0-9-]*$",
        "hooks": [
          { "type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/writer_stop.py", "--plazo", "50"], "timeout": 60 }
        ]
      }
    ]
  }
}
